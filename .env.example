# Coolify runtime settings
NODE_ENV=production
PORT=8080
TRUST_PROXY=1
APP_BASE_URL=https://substrata-jobs.drilling.co.nz
DATABASE_URL=postgresql://substrata_jobs:replace-me@postgres:5432/substrata
# Optional owner connection used only by the migration command.
# Omit when the restricted Jobs role owns jobs_app and can run its migrations.
MIGRATION_DATABASE_URL=
PGSSLMODE=disable
RUN_MIGRATIONS=true
SESSION_DURATION_DAYS=30
COOKIE_SECURE=true
# Read-only point lookup: copy the working Field CORE-GS runtime settings.
# Set enabled=true in Coolify to load points; never expose these at build time.
CORE_GS_ENABLED=false
CORE_GS_HOST=
CORE_GS_DATABASE=
CORE_GS_USER=
CORE_GS_PASSWORD=
CORE_GS_PORT=
CORE_GS_INSTANCE=
CORE_GS_CLNT_ID=Geotechnical
CORE_GS_ENCRYPT=false
CORE_GS_TRUST_SERVER_CERTIFICATE=true
# Optional technical-module launch only; not used to fetch points.
FIELD_BASE_URL=http://substrata.field.mcm
FIELD_JOBS_KEY=

# Step 5: server-only signature encryption. Supply a random 32-byte base64 key;
# the key in compose.local.yaml is ONLY for isolated local tests.
SIGNATURE_ENCRYPTION_KEY=
SIGNATURE_KEY_ID=v1
# Optional JSON object mapping previous key IDs to base64 keys during rotation.
SIGNATURE_PREVIOUS_KEYS=

# Microsoft 365 service mailbox. Unconfigured email leaves Jobs/PDFs usable.
EMAIL_PROVIDER=microsoft_graph
EMAIL_FROM=substrata-jobs@drilling.co.nz
EMAIL_REPLY_TO=substrata-jobs@drilling.co.nz
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=

# Optional future Ops jobs column containing its supervisor-selected contact UUID.
# The current Ops schema does not have this selection; leave unset for now.
OPS_JOB_CONTACT_COLUMN=
