# Coolify runtime settings
NODE_ENV=production
PORT=8080
TRUST_PROXY=1
APP_BASE_URL=https://substrata-jobs.drilling.co.nz
DATABASE_URL=postgresql://substrata_jobs:replace-me@postgres:5432/substrata
# Optional owner connection used only by the migration command.
# Omit when the restricted Jobs role owns jobs_app and can run its migrations.
MIGRATION_DATABASE_URL=
PGSSLMODE=disable
RUN_MIGRATIONS=true
SESSION_DURATION_DAYS=30
COOKIE_SECURE=true
FIELD_BASE_URL=https://substrata-field.mcm

# Local-only escape hatch. Never enable in production.
VITE_BYPASS_AUTH=false
